  volume = {101},
  pages = {pp. 1011-1041},
  number = {6},
  abstract = {This paper suggests a new procedure for evaluating the fit of a dynamic
	structural economic model. The procedure begins by augmenting the
	variables in the model with just enough stochastic error so that
	the model can exactly match the second moments of the actual data.
	Measures of fit for the model can then be constructed on the basis
	of the size of this error. The procedure is applied to a standard
	real business cycle model. Over the business cycle frequencies, the
