  title = {Structural shocks and the comovements between output and interest
	rates},
  journal = {Journal of Economic Dynamics and Control},
  year = {2010},
  volume = {34},
  pages = {1171-1186},
  number = {6},
  month = {June},
  abstract = {Stylized facts on U.S. output and interest rates have so far proved
	hard to match with simple DSGE models. I estimate covariances between
	output, nominal and real interest rate conditional on structural
	shocks, since such evidence has largely been lacking in previous
	discussions of the output-interest rate puzzle. Conditional on shocks
